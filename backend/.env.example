# --- Prisma CLI (migrations/seed) — schema owner, full DDL -----------------
# docker-compose.yml at repo root provides the dev DB.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/pensiones?schema=public"

# --- API runtime — least-privilege role (created by `pnpm db:grants`) ------
# No DDL; audit_logs is append-only for this role.
APP_DATABASE_URL="postgresql://APP_USER:APP_PASSWORD@localhost:5432/pensiones?schema=public"

# --- App --------------------------------------------------------------------
NODE_ENV=development
PORT=3000
