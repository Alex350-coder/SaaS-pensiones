# --- Prisma CLI (migrations/seed) — schema owner, full DDL -----------------
# docker-compose.yml at repo root provides the dev DB.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/pensiones?schema=public"

# --- API runtime — least-privilege role (created by `pnpm db:grants`) ------
# No DDL; audit_logs is append-only for this role.
APP_DATABASE_URL="postgresql://APP_USER:APP_PASSWORD@localhost:5432/pensiones?schema=public"

# --- App --------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# --- Auth (docs/security.md §4) ---------------------------------------------
# Access JWT signing secret, min 32 chars. Generate a strong random value.
JWT_ACCESS_SECRET="CHANGE_ME_min_32_chars_random_secret"
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# --- CORS & cookies (Phase 18) ----------------------------------------------
# Comma-separated browser origins allowed by CORS. Leave empty in dev (the Vite
# proxy makes the SPA same-origin) and for the same-origin nginx prod topology.
CORS_ORIGINS=
# Auth cookies (access/refresh/csrf) are marked Secure when true. Defaults to
# NODE_ENV==production; set false to authenticate over plain http:// locally.
COOKIE_SECURE=false
# Optional cookie Domain. Leave unset for host-only cookies (recommended).
# COOKIE_DOMAIN=
