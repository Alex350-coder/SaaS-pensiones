# Production environment for docker-compose.prod.yml.
#   cp .env.prod.example .env.prod   →  fill in real secrets  →  keep out of git.
# The repo .gitignore already ignores .env and .env.* — never commit .env.prod.

# --- Postgres (migration owner) --------------------------------------------
POSTGRES_USER=pensiones
# CHANGE ME: strong random password for the DB owner.
POSTGRES_PASSWORD=CHANGE_ME_db_owner_password
POSTGRES_DB=pensiones

# --- API runtime role (least privilege) ------------------------------------
# NOTE: the role + its password are created by prisma/sql/runtime-role.sql,
# which the container runs at startup. Keep APP_DB_PASSWORD in sync with that
# file (rotating it is an ops step: ALTER ROLE pensiones_app PASSWORD '…').
APP_DB_USER=pensiones_app
APP_DB_PASSWORD=pensiones_app_dev

# --- Auth (docs/security.md §4) --------------------------------------------
# CHANGE ME: >=32 random chars. Generate: `openssl rand -hex 32`.
JWT_ACCESS_SECRET=CHANGE_ME_min_32_chars_random_secret_value
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# --- Web / cookies ---------------------------------------------------------
# Comma-separated browser origins allowed by CORS. Empty is fine for the
# same-origin nginx topology (the browser never makes a cross-origin call).
CORS_ORIGINS=
# Auth cookies are marked Secure (HTTPS-only) when true. Set to false only to
# smoke-test the stack locally over plain http://localhost.
COOKIE_SECURE=true
# Host port the nginx web tier is published on.
WEB_PORT=80
